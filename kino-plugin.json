{
  "id": "jkanime",
  "name": "JKAnime",
  "version": "1.1.0",
  "apiVersion": 6,
  "entry": "plugin.js",
  "description": "Anime, OVAs y películas de jkanime.net. Búsqueda precisa y selección manual de servidor.",
  "author": "community",
  "homepage": "https://github.com/yumehotaru41-rgb/kino-plugin-jkanime",
  "hosts": [
    "jkanime.net",
    "*.jkanime.net",
    "jkanime.bz",
    "*.jkanime.bz",
    "cdn.jkdesu.com",
    "*.jkdesu.com",
    "cdn.jkanime.net",
    "streamwish.com",
    "*.streamwish.com",
    "streamwish.to",
    "*.streamwish.to",
    "voe.sx",
    "*.voe.sx",
    "mixdrop.co",
    "*.mixdrop.co",
    "mixdrop.ag",
    "mp4upload.com",
    "*.mp4upload.com",
    "filemoon.sx",
    "*.filemoon.sx",
    "streamtape.com",
    "*.streamtape.com",
    "ok.ru",
    "*.ok.ru",
    "embedsito.com",
    "*.embedsito.com",
    "www.mp4upload.com"
  ],
  "streamHosts": "any",
  "capabilities": ["search", "home", "browse", "episodes", "resolve"],
  "categories": ["anime", "series", "movies"],
  "color": "#E74C3C",
  "icon": "icon.png",
  "theme": {
    "accent": "#E74C3C",
    "onAccent": "#FFFFFF",
    "background": "#0D0D0D",
    "surface": "#1A1A1A",
    "highlight": "#FF6B6B"
  },
  "settings": [
    {
      "key": "baseHost",
      "label": "Dominio",
      "type": "select",
      "default": "jkanime.net",
      "options": [
        { "value": "jkanime.net", "label": "jkanime.net" },
        { "value": "jkanime.bz", "label": "jkanime.bz (espejo)" }
      ]
    },
    {
      "key": "preferServer",
      "label": "Servidor preferido",
      "type": "select",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Automático (primero disponible)" },
        { "value": "streamwish", "label": "StreamWish" },
        { "value": "voe", "label": "VOE" },
        { "value": "mixdrop", "label": "MixDrop" },
        { "value": "mp4upload", "label": "Mp4Upload" },
        { "value": "filemoon", "label": "Filemoon" },
        { "value": "streamtape", "label": "Streamtape" },
        { "value": "desu", "label": "Desu / Nozomi" }
      ]
    }
  ],
  "browser": "pages"
}
